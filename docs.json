{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Monte Platform",
  "colors": {
    "primary": "#315594",
    "light": "#70A6C1",
    "dark": "#2F3675"
  },
  "favicon": "/favicon.png",
