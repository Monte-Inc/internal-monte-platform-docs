          "concepts/experiment",
          "concepts/evaluation",
          "concepts/training",
          "concepts/improvement"
        ]
      },
      {
        "group": "Agentic Post-Training",
        "pages": [
          "concepts/improver"
        ]
      },
      {
        "group": "CLI Reference",
        "pages": [
          "cli/overview",
          "cli/experiment",
          "cli/eval",
          "cli/train",
          "cli/status",
          "cli/logs",
          "cli/promote",
          "cli/env",
          "cli/dataset",
          "cli/sync",
          "cli/box"
        ]
      }
    ]
  },
