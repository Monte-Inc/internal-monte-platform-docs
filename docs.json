    {
      "source": "/concepts/measurement",
      "destination": "/concepts/experiment"
    },
    {
      "source": "/troubleshooting",
      "destination": "/"
    },
    {
      "source": "/environments/authoring",
      "destination": "/concepts/environments"
    },
    {
      "source": "/cli/experiments",
      "destination": "/cli/experiment"
    },
    {
