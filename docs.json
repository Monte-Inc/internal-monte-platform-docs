{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Monte Platform",
  "colors": {
    "primary": "#315594",
    "light": "#70A6C1",
    "dark": "#2F3675"
  },
  "favicon": "/favicon.png",
  "banner": {
    "content": "Monte is in closed beta. Interfaces and docs change quickly.",
    "dismissible": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/environments",
          "concepts/measurement",
          "concepts/evaluation",
          "concepts/training",
          "concepts/improvement",
          "concepts/improver",
          "concepts/glossary"
        ]
      },
      {
        "group": "CLI reference",
        "pages": [
          "cli/overview"
        ]
      },
      {
        "group": "Environments",
        "pages": [
          "environments/authoring"
        ]
      },
      {
        "group": "Console",
        "pages": [
          "console/overview"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "troubleshooting"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/concepts/environment",
      "destination": "/concepts/environments"
    },
    {
      "source": "/real-box",
      "destination": "/quickstart"
    },
    {
      "source": "/concepts/loop",
      "destination": "/concepts/improvement"
    },
    {
      "source": "/concepts/runs-ledger",
      "destination": "/concepts/glossary"
    },
    {
      "source": "/concepts/run-lineage",
      "destination": "/concepts/glossary"
    },
    {
      "source": "/concepts/ledger",
      "destination": "/concepts/glossary"
    },
    {
      "source": "/concepts/splits-baselines",
      "destination": "/concepts/improvement"
    }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Monte-Inc/internal-monte-platform"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Monte-Inc"
    }
  }
}
